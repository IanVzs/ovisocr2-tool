# 项目常用开发命令。
.PHONY: help run install install-desktop install-llama serve quit status \
	show-version set-version generate-version-file \
	pkg-binary install-app pkg-deb pkg-rpm pkg pkg-clean

# 版本号唯一权威源是 pyproject.toml。打包时冻结到 ocr_tool/_version.py 供运行时读。
VERSION := $(shell awk -F'"' '/^version[[:space:]]*=/ {print $$2; exit}' pyproject.toml)
VERSION_FILE := ocr_tool/_version.py
VERSION_SEMVER_RE := ^[0-9]+\.[0-9]+\.[0-9]+$$
VENV := .venv
DESKTOP_SRC := packaging/ocr-tool.desktop
DESKTOP_DST := $(HOME)/.local/share/applications/ocr-tool.desktop
DESKTOP_LINK := $(HOME)/桌面/ocr-tool.desktop
ICON_SRC := packaging/ocr-tool-icon-256.png
ICON_DST := $(HOME)/.local/share/icons/hicolor/256x256/apps/ocr-tool.png
ROOT := $(abspath .)
DIST_DIR := dist
PYI_DIR := $(DIST_DIR)/ocr-tool
PKG_DIR := $(DIST_DIR)/pkg
# 独立安装（不依赖源码）落地位置。
APP_LIB_DIR := $(HOME)/.local/lib/ocr-tool
BIN_LINK := $(HOME)/.local/bin/ocr-tool
PKG_DESKTOP := packaging/linux/ocr-tool.desktop
# 共享数据目录（dev 与安装版共用；避免重复下载模型）。可用 OCR_TOOL_DATA_DIR 覆盖。
ifdef OCR_TOOL_DATA_DIR
DATA_DIR := $(OCR_TOOL_DATA_DIR)
else
DATA_DIR := $(if $(XDG_DATA_HOME),$(XDG_DATA_HOME),$(HOME)/.local/share)/ocr-tool
endif
MODELS_DIR := $(DATA_DIR)/models
LLAMA_BIN = $(shell ls $(DATA_DIR)/llama-bin/**/llama-server 2>/dev/null | head -1)
PORT ?= 8080

# 优先：命令行/环境 PYTHON → 已激活 VIRTUAL_ENV → 项目 .venv → python3
ifeq ($(origin PYTHON),undefined)
  ifneq ($(VIRTUAL_ENV),)
    PYTHON := $(VIRTUAL_ENV)/bin/python
  else ifneq ($(wildcard $(VENV)/bin/python),)
    PYTHON := $(VENV)/bin/python
  else
    PYTHON := python3
  endif
endif

help: ## 显示可用 make 命令及说明
	@echo "可用命令："
	@awk 'BEGIN {FS = ":.*##"} /^[a-zA-Z0-9_-]+:.*##/ { printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2 }' $(MAKEFILE_LIST)
	@echo
	@echo "当前 Python: $(PYTHON)"

run: ## 托盘截图 OCR（终端打印进度日志）
	$(PYTHON) -m ocr_tool

install: ## 创建/使用 .venv，装 Python 依赖 + editable + 桌面入口
	$(PYTHON) -m pip install --upgrade pip
	$(PYTHON) -m pip install -r requirements.txt
	$(PYTHON) -m pip install -e .
	@$(MAKE) install-desktop PYTHON="$(PYTHON)"
	@echo "提示：还需推理后端（llama-server + 模型）。若未安装，运行 make install-llama"

install-llama: ## 下载预编译 llama-server(默认 Vulkan) + 官方 GGUF 到共享数据目录（免编译）
	$(PYTHON) scripts/fetch_backend.py
	@echo "已落地到共享数据目录: $(DATA_DIR)（dev 与安装版共用，不重复下载）"
	@echo "纯 CPU 机器可用: OCR_TOOL_LLAMA_VARIANT=cpu make install-llama"

serve: ## 手动前台启动 llama-server（调试用；正常由托盘自动拉起）
	@test -n "$(LLAMA_BIN)" && test -x "$(LLAMA_BIN)" || (echo '未找到 llama-server，先 make install-llama' >&2 && false)
	@MODEL=$$(ls $(MODELS_DIR)/HunyuanOCR-*.gguf 2>/dev/null | grep -v mmproj | head -1); \
	MMPROJ=$$(ls $(MODELS_DIR)/mmproj-*.gguf 2>/dev/null | head -1); \
	test -n "$$MODEL" || (echo '未找到模型 GGUF，先 make install-llama' >&2 && false); \
	"$(LLAMA_BIN)" -m "$$MODEL" --mmproj "$$MMPROJ" -ngl 99 --host 127.0.0.1 --port $(PORT) \
		--alias HYVL --ctx-size 8192 --n-predict 4096

install-desktop: ## 仅安装 .desktop + 图标（用当前 PYTHON；不跑 pip）
	@mkdir -p "$(HOME)/.local/share/applications" "$(dir $(ICON_DST))"
	@cp -f "$(ICON_SRC)" "$(ICON_DST)"
	@sed -e 's|@ROOT@|$(ROOT)|g' -e 's|@PYTHON@|$(PYTHON)|g' \
		-e 's|@ICON@|$(ICON_DST)|g' \
		$(DESKTOP_SRC) > $(DESKTOP_DST)
	@chmod 644 $(DESKTOP_DST)
	@if [ -d "$(HOME)/桌面" ]; then \
		cp -f $(DESKTOP_DST) $(DESKTOP_LINK); \
		chmod +x $(DESKTOP_LINK) 2>/dev/null || true; \
	fi
	@command -v gtk-update-icon-cache >/dev/null 2>&1 && \
		gtk-update-icon-cache -f -t "$(HOME)/.local/share/icons/hicolor" 2>/dev/null || true
	@command -v update-desktop-database >/dev/null 2>&1 && \
		update-desktop-database "$(HOME)/.local/share/applications" 2>/dev/null || true
	@echo "桌面入口: $(DESKTOP_DST)"
	@echo "图标: $(ICON_DST)"
	@echo "Exec Python: $(PYTHON)"

quit: ## 退出托盘应用
	$(PYTHON) -m ocr_tool --quit

status: ## 查看托盘任务列表
	$(PYTHON) -m ocr_tool --status

generate-version-file: ## 从 pyproject.toml 冻结版本到 ocr_tool/_version.py（打包前必跑）
	@printf '# Auto-generated by `make generate-version-file`. DO NOT EDIT.\n' > $(VERSION_FILE)
	@printf '# Source of truth: pyproject.toml (改版本用 `make set-version VERSION=x.y.z`).\n' >> $(VERSION_FILE)
	@printf '__version__ = "%s"\n' "$(VERSION)" >> $(VERSION_FILE)
	@echo "已生成 $(VERSION_FILE) -> $(VERSION)"

pkg-binary: generate-version-file ## PyInstaller 打成 dist/ocr-tool/ 独立运行目录（不依赖源码）
	@command -v pyinstaller >/dev/null 2>&1 || $(PYTHON) -m pip install pyinstaller
	$(PYTHON) -m PyInstaller --noconfirm --clean packaging/pyinstaller/ocr-tool.spec

install-app: pkg-binary ## 把独立包安装到 ~/.local（不依赖源码目录），装桌面入口
	@rm -rf "$(APP_LIB_DIR)"
	@mkdir -p "$(APP_LIB_DIR)" "$(HOME)/.local/bin" "$(dir $(ICON_DST))"
	@cp -a "$(PYI_DIR)/." "$(APP_LIB_DIR)/"
	@ln -sf "$(APP_LIB_DIR)/ocr-tool" "$(BIN_LINK)"
	@cp -f "$(ICON_SRC)" "$(ICON_DST)"
	@sed -e 's|^Exec=.*|Exec=$(APP_LIB_DIR)/ocr-tool|' $(PKG_DESKTOP) > $(DESKTOP_DST)
	@chmod 644 $(DESKTOP_DST)
	@if [ -d "$(HOME)/桌面" ]; then cp -f $(DESKTOP_DST) $(DESKTOP_LINK); chmod +x $(DESKTOP_LINK) 2>/dev/null || true; fi
	@command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$(HOME)/.local/share/icons/hicolor" 2>/dev/null || true
	@command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$(HOME)/.local/share/applications" 2>/dev/null || true
	@echo "已安装独立版到 $(APP_LIB_DIR)（可执行: $(BIN_LINK)）"
	@echo "首次使用先下载后端与模型: ocr-tool --setup-backend  （或已 make install-llama 过则共用）"

pkg-deb: pkg-binary ## 生成 .deb 到 dist/pkg/（需 nfpm）
	@command -v nfpm >/dev/null 2>&1 || { echo '缺少 nfpm，见 https://nfpm.goreleaser.com' >&2; exit 1; }
	@mkdir -p $(PKG_DIR)
	VERSION=$(VERSION) nfpm pkg --packager deb --config packaging/nfpm.yaml --target $(PKG_DIR)/

pkg-rpm: pkg-binary ## 生成 .rpm 到 dist/pkg/（需 nfpm）
	@command -v nfpm >/dev/null 2>&1 || { echo '缺少 nfpm，见 https://nfpm.goreleaser.com' >&2; exit 1; }
	@mkdir -p $(PKG_DIR)
	VERSION=$(VERSION) nfpm pkg --packager rpm --config packaging/nfpm.yaml --target $(PKG_DIR)/

pkg: pkg-deb pkg-rpm ## 一次性生成 deb + rpm
	@ls -lh $(PKG_DIR)/

pkg-clean: ## 清理打包中间与产物
	rm -rf build/ $(DIST_DIR)
	rm -f $(VERSION_FILE)

show-version: ## 显示当前版本号（读自 pyproject.toml）
	@echo $(VERSION)

set-version: ## 用法: make set-version VERSION=x.y.z  统一改 pyproject.toml 并 git commit
	@test -n "$(VERSION)" || (echo '用法: make set-version VERSION=x.y.z  （示例: make set-version VERSION=1.0.1）' >&2 && false)
	@echo "$(VERSION)" | grep -qE '$(VERSION_SEMVER_RE)' || (echo 'VERSION 需为语义化版本号 x.y.z（三位数字段）' >&2 && false)
	@sed -i 's/^version = ".*"/version = "$(VERSION)"/' pyproject.toml
	@echo "已统一设置为 $(VERSION)"
	@if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then \
		git add pyproject.toml; \
		if git diff --cached --quiet -- pyproject.toml; then \
			echo '版本文件相对 HEAD 无变化，跳过 git commit'; \
		else \
			git commit -m "chore: bump version to $(VERSION)" -- pyproject.toml; \
		fi; \
	else \
		echo '当前目录不是 git 仓库，已改 pyproject.toml，跳过 commit'; \
	fi
